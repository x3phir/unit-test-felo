FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /build/felo-demo ./cmd/felo-demo

FROM alpine:3.20

RUN apk add --no-cache ca-certificates
COPY --from=builder /build/felo-demo /usr/local/bin/felo-demo

EXPOSE 50051 50052 50053 50054 50055
EXPOSE 50056 50057 50058 50059 50060
EXPOSE 50061 50062 50063 50064 50065
EXPOSE 50066 50067 50068

ENV FELO_AUTH_JWT=demo-functional-token
ENV FELO_RIDE_GRPC_ADDR=127.0.0.1:50051
ENV FELO_MATCHING_GRPC_ADDR=127.0.0.1:50052
ENV FELO_WALLET_GRPC_ADDR=127.0.0.1:50053
ENV FELO_PAYMENT_GRPC_ADDR=127.0.0.1:50054
ENV FELO_LOCATION_GRPC_ADDR=127.0.0.1:50055
ENV FELO_AUTH_GRPC_ADDR=127.0.0.1:50056
ENV FELO_USER_GRPC_ADDR=127.0.0.1:50057
ENV FELO_DRIVER_GRPC_ADDR=127.0.0.1:50058
ENV FELO_ORDER_GRPC_ADDR=127.0.0.1:50059
ENV FELO_CART_GRPC_ADDR=127.0.0.1:50060
ENV FELO_PRICING_GRPC_ADDR=127.0.0.1:50061
ENV FELO_SENDORDER_GRPC_ADDR=127.0.0.1:50062
ENV FELO_SHIPMENT_GRPC_ADDR=127.0.0.1:50063
ENV FELO_TRACKING_GRPC_ADDR=127.0.0.1:50064
ENV FELO_MERCHANT_GRPC_ADDR=127.0.0.1:50065
ENV FELO_INVOICE_GRPC_ADDR=127.0.0.1:50066
ENV FELO_NOTIFICATION_GRPC_ADDR=127.0.0.1:50067
ENV FELO_FEEDBACK_GRPC_ADDR=127.0.0.1:50068

ENTRYPOINT ["felo-demo"]
